datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  BUREAU
  MEMBRE_ACTIF
  MEMBRE_DROIT
  SYMPATHISANT
}

enum StatusCotisation {
  A_JOUR
  EN_RETARD
  EXEMPTE
}

enum UserType {
  ENTREPRENEUR
  SALARIE
  DEMANDEUR_EMPLOI
  ETUDIANT
  AUTRE
}

enum PostCategory {
  ANNONCE
  OFFRE_EMPLOI
  OFFRE_SOUS_TRAITANCE
  COMMUNICATION
  EVENEMENT
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  firstName     String
  lastName      String
  phone         String?
  whatsapp      String?
  residence     String           @default("Gamba")
  isDiaspora    Boolean          @default(false)
  role          Role             @default(SYMPATHISANT)
  userType      UserType         @default(ENTREPRENEUR)
  statutCotiz   StatusCotisation @default(EN_RETARD)
  bio           String?          
  skills        String?          
  companyName   String?          
  portfolioUrl  String?          
  resumeUrl     String?          // URL du CV téléversé (PDF/Doc)
  companyDocUrl String?          // URL du dossier entreprise (Plaquette, RCCM, NIF, etc.)
  isAjednMember Boolean          @default(true) 
  
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  contributions Contribution[]
  projects      Project[]        @relation("ProjectOwner")
  posts         Post[]

  @@map("ajedn_users")
}

model Contribution {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Float    @default(5000)
  month         String
  paid          Boolean  @default(false)
  paymentDate   DateTime?
  receiptRef    String?

  createdAt     DateTime @default(now())

  @@map("ajedn_contributions")
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  status      String   @default("En cours")
  budget      Float?
  ownerId     String?
  owner       User?    @relation("ProjectOwner", fields: [ownerId], references: [id])
  location    String   @default("Gamba")

  createdAt   DateTime @default(now())

  @@map("ajedn_projects")
}

model Post {
  id          String       @id @default(cuid())
  title       String
  content     String
  category    PostCategory @default(ANNONCE)
  fileUrl     String?      // Pièce jointe à la publication (PDF, Image, etc.)
  authorId    String
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  location    String       @default("Gamba")
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("ajedn_posts")
}